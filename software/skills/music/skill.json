{
  "id": "music",
  "name": "放音乐",
  "version": "1.0.0",
  "author": "ZELUX 智造社",
  "description": "播放 var/music 里的歌，支持下一首、暂停、音量、歌单",
  "triggers": [
    "播放音乐",
    "放首歌",
    "放点音乐",
    "来首歌",
    "听歌",
    "放音乐",
    "下一首",
    "上一首",
    "换个歌",
    "暂停",
    "继续放",
    "接着放",
    "音量",
    "声音大",
    "声音小",
    "什么歌",
    "歌单",
    "有什么歌",
    "别放了",
    "关掉音乐"
  ],
  "params": [
    {
      "name": "what",
      "type": "str",
      "required": false,
      "description": "歌名或歌手，可以不填",
      "pattern": "(?:放|听|来)(?:一首|首)?(?:歌)?[《]?([^《》，。,.!?]{1,20})[》]?"
    }
  ],
  "permissions": ["audio"],
  "needs": ["audio"],
  "priority": 70
}
